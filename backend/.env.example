# 백엔드 환경변수 예시. 실제 값은 .env로 복사해 설정 (커밋 금지).

# CurseForge API 키 (console.curseforge.com 발급). 없으면 fixture 데이터로 자동 대체됨.
CURSEFORGE_API_KEY=

# Optional OpenAI API key for more natural chat parsing/replies; without it the chat falls back to rule-based logic.
OPENAI_API_KEY=

# Optional: 사내 APIM Foundry 프록시를 OpenAI 대신 사용 (설정돼 있으면 우선순위 높음).
# 절대 실제 값을 커밋하지 말 것 - 이 파일을 .env로 복사해서 값을 채워 넣을 것.
# 베이스 URL (모델명 없이, 예: https://apim-foundryproxy-dev.azure-api.net/foundry)
APIM_BASE_URL=
# 운영자가 발급해준 APIM 공통 키 (절대 공유 금지!)
APIM_KEY=
# 사용할 채팅 모델명 (URL 경로에 그대로 들어감)
CHAT_MODEL=gpt-4o-mini

# 프론트엔드 배포 도메인 (콤마로 여러 개, CORS 허용 목록)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# SQLite DB 파일 저장 경로 (Render Persistent Disk 마운트 경로 등)
DATA_DIR=./data
