# 백엔드 환경변수 예시. 실제 값은 .env로 복사해 설정 (커밋 금지).

# CurseForge API 키 (console.curseforge.com 발급). 없으면 fixture 데이터로 자동 대체됨.
CURSEFORGE_API_KEY=

# 프론트엔드 배포 도메인 (콤마로 여러 개, CORS 허용 목록)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# SQLite DB 파일 저장 경로 (Render Persistent Disk 마운트 경로 등)
DATA_DIR=./data
